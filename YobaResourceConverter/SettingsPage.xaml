<UserControl
	x:Class="YobaResourceConverter.SettingsPage"
	xmlns:local="clr-namespace:YobaResourceConverter"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	xmlns:s="clr-namespace:System;assembly=mscorlib"
	
	mc:Ignorable="d"
	
	d:DataContext="{d:DesignInstance local:SettingsPage, IsDesignTimeCreatable=True}"
	d:DesignWidth="500"
	d:DesignHeight="450"
>
    <Grid>
		<ScrollViewer
			Style="{StaticResource ScrollViewer}"
	>
		<StackPanel
			Margin="{StaticResource ContentMargin}"	
		>
				<TextBlock
					Style="{StaticResource PageTitleTextBlock}"
					Text="Settings"
				/>
				
				<TextBlock
					Style="{StaticResource TitleTextBlock}"
					Text="YOBA include path (optional)"
				/>

				<TextBox
					Style="{StaticResource TextBox}"
					x:Name="YobaPathTextBox"
					Text=""
					TextChanged="OnYobaPathTextBoxTextChanged"
				/>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
