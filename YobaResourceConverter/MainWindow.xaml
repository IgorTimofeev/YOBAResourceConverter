<Window
	x:Class="YobaResourceConverter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:s="clr-namespace:System;assembly=mscorlib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:YobaResourceConverter"
    mc:Ignorable="d"
		
    Title="YOBA | Resource converter"

	MinWidth="250"
	MinHeight="250"
	Width="470"
	Height="458"

	WindowStyle="None"
		
	Background="{StaticResource ThemeBg1}"
>
	<WindowChrome.WindowChrome>
		<WindowChrome
			CaptionHeight="0"
			CornerRadius="5"
			GlassFrameThickness="0"
			ResizeBorderThickness="3"
		/>
	</WindowChrome.WindowChrome>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="30"/>
			<RowDefinition/>
		</Grid.RowDefinitions>

		<Border
			x:Name="WindowTopPanel"
			Background="{StaticResource ThemeBg3}"	
			MouseDown="OnWindowTopPanelMouseDown"
		>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<TextBlock
					Margin="8,0,0,0"
					VerticalAlignment="Center"
					Foreground="{StaticResource ThemeFg4}"
					FontSize="12"
					Text="YOBA | Resource converter"
				/>

				<StackPanel
					Grid.Column="1"
					Orientation="Horizontal"	
					HorizontalAlignment="Right"
				>
					<Button
						x:Name="WindowCloseButton"
						Style="{StaticResource WindowCloseButton}"
						Content="X"
						Click="OnWindowCloseButtonClick"
					/>
				</StackPanel>
			</Grid>
		</Border>
		
		<TabControl
			x:Name="TabControl"
			Grid.Row="1"
			Style="{StaticResource TabControl}"
			Margin="0,10,0,0"
			SelectionChanged="OnTabControlSelectionChanged"
		>
			<TabItem
				Style="{StaticResource TabItem}"
			>
				<TabItem.Header>
					Fonts
				</TabItem.Header>

				<TabItem.Content>
					<local:FontPage/>
				</TabItem.Content>
			</TabItem>

			<TabItem
				Style="{StaticResource TabItem}"
			>
				<TabItem.Header>
					Images
				</TabItem.Header>

				<TabItem.Content>
					<local:ImagePage/>
				</TabItem.Content>
			</TabItem>
			
			<TabItem
				Style="{StaticResource TabItem}"
			>
				<TabItem.Header>
					Settings
				</TabItem.Header>

				<TabItem.Content>
					<local:SettingsPage/>
				</TabItem.Content>
			</TabItem>
		</TabControl>
	</Grid>
</Window>
