<UserControl
	x:Class="YobaResourceConverter.FontPage"
	xmlns:local="clr-namespace:YobaResourceConverter"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	
	mc:Ignorable="d"
	
	d:DataContext="{d:DesignInstance local:FontPage, IsDesignTimeCreatable=True}"
	d:DesignWidth="500"
	d:DesignHeight="450"
>
	<ScrollViewer
		Style="{StaticResource ScrollViewer}"	
	>
		<StackPanel
			Margin="{StaticResource ContentMargin}"	
		>
			<TextBlock
				Style="{StaticResource PageTitleTextBlock}"
				Text="Fonts"
			/>
				
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>
			
				<StackPanel>
					<TextBlock
						Style="{StaticResource TitleTextBlock}"
						Text="Font family"
					/>

					<ComboBox
						Style="{StaticResource ComboBox}"
						x:Name="FontFamilyComboBox"
						SelectedIndex="0"
					>
						<ComboBox.ItemTemplate>
							<DataTemplate DataType="FontFamily">
								<TextBlock
									FontFamily="{Binding}"
									Text="{Binding}"
								/>	
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
				</StackPanel>

				<StackPanel
					Grid.Column="1"	
					Margin="10,0,0,0"
				>
					<TextBlock
						Style="{StaticResource TitleTextBlock}"
						Text="Font size"
					/>
				
					<TextBox
						Style="{StaticResource TextBox}"
						x:Name="FontSizeTextBox"
						Text="16"
					/>
				</StackPanel>
			</Grid>

			<TextBlock
				Style="{StaticResource TitleTextBlock}"
				Text="Character set"
			/>
				
			<TextBox
				x:Name="CharacterSetTextBox"
				Style="{StaticResource TextBox}"
				Text="ABCDEF"
			/>
				
			<TextBlock
				Style="{StaticResource TitleTextBlock}"
				Text="Namespace (optional)"
			/>
					
			<TextBox
				Style="{StaticResource TextBox}"
				x:Name="NamespaceTextBox"
				Text=""
				TextChanged="OnNamespaceTextBoxTextChanged"
			/>

			<TextBlock
				Style="{StaticResource TitleTextBlock}"
				Text="Preview"
			/>

			<Border
				SnapsToDevicePixels="True"
				Background="{StaticResource ThemeBg3}"
				BorderBrush="{StaticResource ThemeBg5}"
				BorderThickness="1"
				CornerRadius="5"
				Padding="5,0,5,0"
				Height="40"
			>
				<Image
					x:Name="PreviewImage"
					Stretch="None"
					RenderOptions.EdgeMode="Aliased"
					RenderOptions.BitmapScalingMode="NearestNeighbor"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
				/>
			</Border>
				
			<Button
				Style="{StaticResource Button}"
				Margin="0,15,0,0"
				Content="Export header"
				Click="OnSaveButtonClick"
			/>
		</StackPanel>
	</ScrollViewer>
</UserControl>
